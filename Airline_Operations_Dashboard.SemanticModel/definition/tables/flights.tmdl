	column 'Flight Date' =
			
			DATE(
			    flights[YEAR],
			    flights[MONTH],
			    flights[DAY]
			)
		formatString: General Date
		lineageTag: a30bfda8-c48a-4d8b-8182-3503d638bdce
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column Route =
			
			flights[ORIGIN_AIRPORT] & " → " & flights[DESTINATION_AIRPORT]
		lineageTag: 48fc2603-1018-4e26-824e-72b5f06afdee
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Cancellation Reason' =
			
			SWITCH(
			    flights[CANCELLATION_REASON],
			    "A", "Airline / Carrier",
			    "B", "Weather",
			    "C", "National Air System",
			    "D", "Security",
			    "Not Cancelled"
			)
		lineageTag: d064682b-0311-498b-9f34-d4d348e3821c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'Scheduled Departure Hour' =
			
			INT(flights[SCHEDULED_DEPARTURE] / 100)
		formatString: 0
		lineageTag: cfd46748-d0d7-402e-a396-23e11dfe7dd6
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Departure Time Band' =
			
			SWITCH(
			    TRUE(),
			    flights[Scheduled Departure Hour] < 6, "Night",
			    flights[Scheduled Departure Hour] < 12, "Morning",
			    flights[Scheduled Departure Hour] < 18, "Afternoon",
			    "Evening"
			)
		lineageTag: 7617d7a5-00c6-458d-97e9-5788911ba7e5
		summarizeBy: none
		sortByColumn: 'Departure Time Band Order'

		annotation SummarizationSetBy = Automatic

	column 'Departure Time Band Order' = SWITCH(TRUE(), flights[Scheduled Departure Hour] < 6, 1, flights[Scheduled Departure Hour] < 12, 2, flights[Scheduled Departure Hour] < 18, 3, 4)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ea8609d9-94f8-4944-867f-2abd0241b9a6
		summarizeBy: none

	partition flights = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents("C:\Users\anush\Downloads\archive\flights.csv"),[Delimiter=",", Columns=31, Encoding=1252, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"YEAR", Int64.Type}, {"MONTH", Int64.Type}, {"DAY", Int64.Type}, {"DAY_OF_WEEK", Int64.Type}, {"AIRLINE", type text}, {"FLIGHT_NUMBER", Int64.Type}, {"TAIL_NUMBER", type text}, {"ORIGIN_AIRPORT", type text}, {"DESTINATION_AIRPORT", type text}, {"SCHEDULED_DEPARTURE", Int64.Type}, {"DEPARTURE_TIME", Int64.Type}, {"DEPARTURE_DELAY", Int64.Type}, {"TAXI_OUT", Int64.Type}, {"WHEELS_OFF", Int64.Type}, {"SCHEDULED_TIME", Int64.Type}, {"ELAPSED_TIME", Int64.Type}, {"AIR_TIME", Int64.Type}, {"DISTANCE", Int64.Type}, {"WHEELS_ON", Int64.Type}, {"TAXI_IN", Int64.Type}, {"SCHEDULED_ARRIVAL", Int64.Type}, {"ARRIVAL_TIME", Int64.Type}, {"ARRIVAL_DELAY", Int64.Type}, {"DIVERTED", Int64.Type}, {"CANCELLED", Int64.Type}, {"CANCELLATION_REASON", type text}, {"AIR_SYSTEM_DELAY", Int64.Type}, {"SECURITY_DELAY", Int64.Type}, {"AIRLINE_DELAY", Int64.Type}, {"LATE_AIRCRAFT_DELAY", Int64.Type}, {"WEATHER_DELAY", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

