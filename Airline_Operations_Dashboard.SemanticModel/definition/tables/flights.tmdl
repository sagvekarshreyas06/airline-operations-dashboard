table flights
	lineageTag: 074b10c4-2085-475d-9430-d4335b3d0c94

	/// All scheduled flights, including cancelled and diverted flights.
	measure 'Total Flights' =
			
			COUNTROWS(flights)
		formatString: #,0
		lineageTag: f5b67f6a-0bb3-47ae-928b-3b32766ebcab

		changedProperty = IsHidden

	/// Flights with CANCELLED = 1.
	measure 'Cancelled Flights' =
			
			CALCULATE(
			    COUNTROWS(flights),
			    flights[CANCELLED] = 1
			)
		formatString: #,0
		lineageTag: 8cf1d600-65a3-4e9a-ab4c-d092c2000ed6

	/// Flights with DIVERTED = 1.
	measure 'Diverted Flights' =
			
			CALCULATE(
			    COUNTROWS(flights),
			    flights[DIVERTED] = 1
			)
		formatString: #,0
		lineageTag: a29c1a56-3c1a-46c4-9d00-6391e4ce04b3

	/// Flights that were neither cancelled nor diverted.
	measure 'Completed Flights' =
			
			CALCULATE(
			    COUNTROWS(flights),
			    flights[CANCELLED] = 0,
			    flights[DIVERTED] = 0
			)
		formatString: #,0
		lineageTag: 49905faa-282d-4453-ac35-c5feed492ad0

	/// Completed flights that arrived less than 15 minutes after the scheduled arrival time (US DOT definition).
	measure 'On Time Flights' = CALCULATE([Completed Flights], flights[ARRIVAL_DELAY] < 15)
		formatString: #,0
		lineageTag: f8406ffb-ad2c-4168-9cda-cf2c8e41f037

	/// Completed flights that arrived 15 or more minutes late.
	measure 'Delayed Flights' = CALCULATE([Completed Flights], flights[ARRIVAL_DELAY] >= 15)
		formatString: #,0
		lineageTag: 994ced53-d598-4dcb-9467-242f44bd1f90

	/// On Time Flights / Completed Flights.
	measure 'On Time %' =
			
			DIVIDE(
			    [On Time Flights],
			    [Completed Flights]
			)
		formatString: 0.0%
		lineageTag: 97cc4951-b858-4dab-a96b-b10033104c96

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Cancelled Flights / Total Flights.
	measure 'Cancellation Rate' =
			
			DIVIDE(
			    [Cancelled Flights],
			    [Total Flights]
			)
		formatString: 0.0%
		lineageTag: 8ea4f9be-bcbc-4286-874d-5fc84f98ee0c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average departure delay in minutes for completed flights only (cancelled and diverted flights excluded). Early departures count as negative minutes.
	measure 'Avg Departure Delay' = CALCULATE(AVERAGE(flights[DEPARTURE_DELAY]), flights[CANCELLED] = 0, flights[DIVERTED] = 0)
		formatString: 0.0
		lineageTag: 72f28f70-e4bc-4aab-8eea-0bca6b11f10d

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Average arrival delay in minutes for completed flights only. Early arrivals count as negative minutes.
	measure 'Avg Arrival Delay' = CALCULATE(AVERAGE(flights[ARRIVAL_DELAY]), flights[CANCELLED] = 0, flights[DIVERTED] = 0)
		formatString: 0.0
		lineageTag: 1211760d-a4c5-438d-9837-eddf8da9e4cd

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Flight Distance' =
			
			AVERAGE(flights[DISTANCE])
		formatString: #,0.0
		lineageTag: 0b2b5cfb-e4b6-4b0a-a902-22d35a0023c0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Distance' =
			
			SUM(flights[DISTANCE])
		formatString: #,0
		lineageTag: 49d53fa3-3177-40ed-bbef-d4a1e3104fa4

	measure 'Avg Taxi Out' =
			
			AVERAGE(flights[TAXI_OUT])
		formatString: #,0.0
		lineageTag: 01b804fa-0799-40df-aff3-66b8e4271ffb

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Taxi In' =
			
			AVERAGE(flights[TAXI_IN])
		formatString: #,0.0
		lineageTag: f9d8f0ee-2dbf-4dea-860b-b49b2906f9d9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Air Time' =
			
			AVERAGE(flights[AIR_TIME])
		formatString: #,0.0
		lineageTag: 17f89b3f-faca-40fb-b7b1-5cc25fed41e7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Scheduled Flight Time' =
			
			AVERAGE(flights[SCHEDULED_TIME])
		formatString: #,0.0
		lineageTag: 99547fe9-9498-44ca-88bc-2cc8974f31cf

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Avg Flight Duration' =
			
			AVERAGE(flights[ELAPSED_TIME])
		formatString: #,0.0
		lineageTag: 94c84717-cf93-47b3-839e-f51732e9d25d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Air System Delay' =
			
			SUM(flights[AIR_SYSTEM_DELAY])
		formatString: #,0
		lineageTag: 12eea1cd-a066-49c6-861b-97bd0f038550

	measure 'Airline Delay' =
			
			SUM(flights[AIRLINE_DELAY])
		formatString: #,0
		lineageTag: 8a86a6e2-23fd-4e8c-b730-615fc6abf328

	measure 'Late Aircraft Delay' =
			
			SUM(flights[LATE_AIRCRAFT_DELAY])
		formatString: #,0
		lineageTag: 4e56e8d6-c51b-4c87-b865-ad3ce114b3c5

	measure 'Weather Delay' =
			
			SUM(flights[WEATHER_DELAY])
		formatString: #,0
		lineageTag: a8b7885c-8231-408d-8604-607f5570becc

	measure 'Security Delay' =
			
			SUM(flights[SECURITY_DELAY])
		formatString: #,0
		lineageTag: 17e0bfc5-d2de-46f4-9266-519fa6306987

	measure 'Delay Cause Minutes' =
			
			SWITCH(
			    SELECTEDVALUE('Delay Causes'[Delay Cause]),
			    "Air System", [Air System Delay],
			    "Airline", [Airline Delay],
			    "Late Aircraft", [Late Aircraft Delay],
			    "Weather", [Weather Delay],
			    "Security", [Security Delay],
			    0
			)
		formatString: #,0
		lineageTag: 89a9101a-186a-4bbe-bc8b-8d84100cb094

	/// Name of the airline passed to the Airline Detail drill-through page.
	measure 'Airline Detail Title' = SELECTEDVALUE(airlines[AIRLINE], "All airlines")
		lineageTag: f7f222c4-571b-41b5-8816-515ae49ecf58

	column YEAR
		dataType: int64
		formatString: 0
		lineageTag: 2696dfbd-0011-4039-b369-ba983f45053b
		summarizeBy: sum
		sourceColumn: YEAR

		annotation SummarizationSetBy = Automatic

